{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "mcp__*",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git revert *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git pull *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git revert *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git restore *)",
      "PowerShell(git stash *)",
      "PowerShell(git tag *)",
      "Bash(sqlcmd *)",
      "Bash(sqlplus *)",
      "Bash(sqlcl *)",
      "Bash(psql *)",
      "Bash(mysql *)",
      "Bash(sqlite3 *)",
      "Bash(flyway *)",
      "Bash(liquibase *)",
      "Bash(dotnet ef database *)",
      "PowerShell(sqlcmd *)",
      "PowerShell(sqlplus *)",
      "PowerShell(sqlcl *)",
      "PowerShell(psql *)",
      "PowerShell(mysql *)",
      "PowerShell(sqlite3 *)",
      "PowerShell(flyway *)",
      "PowerShell(liquibase *)",
      "PowerShell(dotnet ef database *)",
      "PowerShell(Invoke-Sqlcmd *)",
      "PowerShell(Invoke-DbaQuery *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*connectionstrings*)",
      "Read(**/appsettings.json)",
      "Read(**/appsettings.*.json)"
    ]
  }
}
